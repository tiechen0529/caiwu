# Optional: compose.yaml runs with defaults even without a .env file.
QINGZHANG_IMAGE=ghcr.io/tiechen0529/caiwu:latest
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
ADMIN_USER=admin
# Leave empty to generate a strong random password and persist it in /data.
# To override, provide a password of at least 16 characters; restart the app.
ADMIN_PASSWORD=
# Required only for compose.https.yaml:
DOMAIN=
# Set when using your own Nginx/Caddy proxy, e.g. https://finance.example.com
PUBLIC_ORIGIN=
